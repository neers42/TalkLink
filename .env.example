# MySQL
MYSQL_ROOT_PASSWORD=your_secure_password_here
MYSQL_DATABASE=TalkLinkDB
MYSQL_USER=chat_user
MYSQL_PASSWORD=chat_pass
MYSQL_BACKUP_PASSWORD=your_backup_user_secure_password_here

# Chat Server
DB_HOST=mysql
DB_PORT=3306
# 複数インスタンスで稼働させる場合はインスタンスごとに一意な値を設定すること
CHAT_SERVER_MACHINE_ID=1

# Redis
REDIS_HOST=redis
REDIS_PORT=6379